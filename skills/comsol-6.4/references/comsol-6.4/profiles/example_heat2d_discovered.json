{
  "profile_id": "example_heat2d_discovered",
  "comsol_version": "6.4",
  "description": "Minimal 2-D steady heat-conduction plate example. DISCOVERED ONLY - not production validated. Built from API calls proven in this session's one-shot benchmark.",
  "required_modules": ["Heat Transfer"],
  "verification": {
    "state": "discovered",
    "test_id": null,
