{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Comsol_run/blob/main/skills/comsol-6.4/schemas/task-manifest.schema.json",
  "title": "COMSOL Agent Task Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "parameters", "geometry", "selections", "materials", "physics", "mesh", "study", "outputs", "validation"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "comsol_version", "mode", "task_id", "profile_id"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "comsol_version": {"const": "6.4"},
        "mode": {"enum": ["build", "patch"]},
        "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"},
        "profile_id": {"type": "string", "minLength": 1},
        "source_model": {"type": "string", "minLength": 1},
        "parent_task_id": {"type": "string"},
        "variant_id": {"type": "string"},
        "base_manifest_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "execution_limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
            "graceful_cancel_seconds": {"type": "number", "minimum": 0, "maximum": 300},
            "max_dofs": {"type": "integer", "minimum": 1},
            "max_elements": {"type": "integer", "minimum": 1},
            "max_memory_gb": {"type": "number", "exclusiveMinimum": 0},
            "cores": {"type": "integer", "minimum": 1, "maximum": 256}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "patch"}}, "required": ["mode"]},
          "then": {"required": ["source_model"]}
        }
      ]
    },
    "parameters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/quantityOrExpression"}},
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_tag", "geometry_tag", "dimension", "features"],
      "properties": {
        "component_tag": {"$ref": "#/$defs/tag"},
        "geometry_tag": {"$ref": "#/$defs/tag"},
        "dimension": {"type": "integer", "enum": [1, 2, 3]},
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tag", "api_type", "properties"],
            "properties": {
              "tag": {"$ref": "#/$defs/tag"},
              "api_type": {"type": "string", "minLength": 1},
              "properties": {"type": "object"}
            }
          }
        }
      }
    },
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "kind", "entity_dimension", "expected_count"],
        "properties": {
          "tag": {"$ref": "#/$defs/tag"},
          "kind": {"enum": ["named", "box", "ball", "cylinder", "disk", "explicit_profile"]},
          "entity_dimension": {"type": "integer", "enum": [0, 1, 2, 3]},
          "expected_count": {"type": "integer", "minimum": 1},
          "geometry_tag": {"type": "string"},
          "properties": {"type": "object"},
          "signature": {
            "type": "object",
            "properties": {
              "bounding_box": {"type": "array", "minItems": 2, "maxItems": 2},
              "measure": {"$ref": "#/$defs/quantity"},
              "measure_tolerance": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "profile_id", "selection", "properties"],
        "properties": {
          "tag": {"$ref": "#/$defs/tag"},
          "profile_id": {"type": "string"},
          "selection": {"type": "string"},
          "properties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/quantityOrExpression"}}
        }
      }
    },
    "physics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "profile_id", "component_tag", "geometry_tag", "selection", "settings"],
        "properties": {
          "tag": {"$ref": "#/$defs/tag"},
          "profile_id": {"type": "string"},
          "component_tag": {"type": "string"},
          "geometry_tag": {"type": "string"},
          "selection": {"type": "string"},
          "settings": {"type": "object", "additionalProperties": {"$ref": "#/$defs/quantityOrExpression"}},
          "features": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "component_tag", "geometry_tag", "profile_id"],
      "properties": {
        "tag": {"$ref": "#/$defs/tag"},
        "component_tag": {"type": "string"},
        "geometry_tag": {"type": "string"},
        "profile_id": {"type": "string"},
        "auto_size": {"type": "integer", "minimum": 1, "maximum": 9},
        "refinement_factor": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "max_elements": {"type": "integer", "minimum": 1},
        "minimum_quality": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "profile_id", "steps"],
      "properties": {
        "tag": {"$ref": "#/$defs/tag"},
        "profile_id": {"type": "string"},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tag", "api_type"],
            "properties": {"tag": {"$ref": "#/$defs/tag"}, "api_type": {"type": "string"}}
          }
        },
        "time_step_scale": {"type": "number", "exclusiveMinimum": 0},
        "solver_settings": {"type": "object"},
        "run": {"type": "boolean", "default": false}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantities"],
      "properties": {
        "quantities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "expression"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "expression": {"type": "string", "minLength": 1},
              "expected_unit": {"type": "string"},
              "definition": {
                "type": "object",
                "description": "Physical definition of a scalar observable, e.g. a domain average: {kind, field, operator, domain}.",
                "properties": {
                  "kind": {"type": "string", "minLength": 1},
                  "field": {"type": "string", "minLength": 1},
                  "operator": {"type": "string", "minLength": 1},
                  "domain": {"type": "string", "minLength": 1},
                  "method": {"type": "string", "minLength": 1}
                },
                "additionalProperties": true
              }
            }
          }
        },
        "export_csv": {"type": "boolean"},
        "export_images": {"type": "boolean"},
        "save_model": {"type": "boolean", "default": true}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_gates"],
      "properties": {
        "required_gates": {
          "type": "array", "uniqueItems": true, "minItems": 8, "maxItems": 8,
          "items": {"enum": ["A", "B", "C", "D", "E", "F", "G", "H"]}
        },
        "target_observables": {"type": "array", "items": {"type": "object"}},
        "conservation_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "terms", "relative_tolerance"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "relative_tolerance": {"type": "number", "minimum": 0},
              "equation": {"type": "string", "minLength": 1},
              "reference": {"type": "string", "minLength": 1},
              "terms": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["expression", "expected_unit"],
                  "properties": {
                    "expression": {"type": "string", "minLength": 1},
                    "expected_unit": {"type": "string", "minLength": 1},
                    "coefficient": {"type": "number"},
                    "region": {"type": "string", "minLength": 1},
                    "definition": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        },
        "convergence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mesh_gci_fine_tolerance_percent": {"type": "number", "minimum": 0},
            "time_step_relative_tolerance": {"type": "number", "minimum": 0}
          }
        },
        "baseline": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reference_value", "relative_tolerance"],
            "properties": {
              "reference_value": {"type": "number"},
              "relative_tolerance": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "tag": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"},
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {"value": {"type": "number"}, "unit": {"type": "string", "minLength": 1}, "expected_unit": {"type": "string"}}
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "expected_unit"],
      "properties": {"expression": {"type": "string", "minLength": 1}, "expected_unit": {"type": "string", "minLength": 1}}
    },
    "quantityOrExpression": {"oneOf": [{"$ref": "#/$defs/quantity"}, {"$ref": "#/$defs/expression"}]}
  }
}
